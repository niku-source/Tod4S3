# Token del bot creado con @BotFather. Guárdalo como secreto privado.
TELEGRAM_BOT_TOKEN=
# ID numérico o @usuario del canal/grupo donde se fijará la copia cifrada.
TELEGRAM_BACKUP_CHAT_ID=
# Respaldo automático al arrancar, al cerrar y después de cambios; mínimo 30 s.
TELEGRAM_BACKUP_INTERVAL_SECONDS=300
# En Railway monta un Volume en /data y deja esta ruta configurada.
BOT_DATA_DIR=/data
# ID numérico del dueño para soporte y /reply.
OWNER_TELEGRAM_ID=
# ToDus S3 usa PUT directo con el ID de Telegram como namespace.
# No requiere TODUS_PHONE, TODUS_PASSWORD ni credenciales de cuenta ToDus.
# Modo de entrega del archivo descargado:
#   chat  = enviar el archivo al chat privado de Telegram del usuario (por defecto)
#   todus = enviar el archivo al chat de ToDus del usuario (tráfico nacional;
#           requiere TODUS_PHONE y TODUS_PASSWORD de la cuenta del bot)
#   cloud = subir a ToDus S3 y dar enlaces (no recomendado: ToDus purga los
#           objetos anónimos en menos de un minuto)
DELIVERY_MODE=chat
# Cuenta ToDus del bot: número cubano y contraseña de sesión (se genera
# validando un PIN por SMS; se guarda tras el primer login).
TODUS_PHONE=
TODUS_PASSWORD=
# Horas antes del borrado automático de enlaces de nube (solo modo cloud).
CLOUD_LINK_TTL_HOURS=2
# Cola y límites internos (MiB). Ajusta según el disco temporal disponible.
MAX_CONCURRENT_UPLOADS=2
MAX_PENDING_PER_USER=25
# 0 = sin límite artificial; el archivo se divide en partes para ToDus.
# El límite real depende del origen, el disco temporal y el proveedor.
MAX_FILE_SIZE_MIB=0
MAX_PART_SIZE_MIB=1900
MAX_TRANSFER_HOURS=24
TMPDIR=/tmp
# Opcional, necesario para descargar reenvíos de Telegram de más de ~20 MB con MTProto.
# Obtén API ID y API Hash en my.telegram.org. No son el token del bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Alternativa opcional: si ya operas un servidor Bot API local, configura ambas URLs.
TELEGRAM_API_BASE_URL=
TELEGRAM_FILE_BASE_URL=
# Opcional: IDs autorizados separados por comas. Vacío = cualquiera puede usar el bot.
ALLOWED_TELEGRAM_USER_IDS=
# Alias heredado para destino de respaldos; preferir TELEGRAM_BACKUP_CHAT_ID.
TELEGRAM_CHANNEL_ID=
# Canal de avisos anónimos de altas, referidos y transferencias; bot admin requerido.
# Opcional: PUBLIC_CHANNEL_ID o PUBLIC_TELEGRAM_CHANNEL_ID. Si no se ponen,
# el bot usa REQUIRED_TODUS_CHANNEL y, finalmente, @darzPrbo.
PUBLIC_CHANNEL_ID=@darzPrbo
# URL pública de la web; se añade al final de los avisos del canal.
# Si se omite, Railway intenta usar RAILWAY_PUBLIC_DOMAIN automáticamente.
PUBLIC_SITE_URL=
# Canales y grupo mostrados como enlaces informativos; no se verifica membresía.
REQUIRED_CHANNEL=@Dark_Zone_666
REQUIRED_GROUP=@grupozonaoscura
REQUIRED_TODUS_CHANNEL=@darzPrbo
CHANNEL_JOIN_URL=https://t.me/Dark_Zone_666
GROUP_JOIN_URL=https://t.me/grupozonaoscura
TODUS_CHANNEL_JOIN_URL=https://t.me/darzPrbo
# Las descargas de plataformas admiten solo contenido público; no se usan cookies.
LOG_LEVEL=INFO
